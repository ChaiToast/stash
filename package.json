{
  "name": "stash",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > packages/database/src/database.types.ts",
    "extension:build": "npm run build --workspace=@stash/extension",
    "extension:dev": "npm run dev --workspace=@stash/extension",
    "functions:serve": "supabase functions serve classify-posts --env-file supabase/.env.local",
    "functions:deploy": "supabase functions deploy classify-posts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  }
}
